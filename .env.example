# Copy file này thành .env.local:  copy .env.example .env.local
# Khi deploy lên Vercel, khai báo các biến này trong Settings → Environment Variables

# Formspree - chỉ là lối dự phòng cho thiệp gốc khi chưa có Redis.
# Nền tảng Tơ Hồng lưu xác nhận tham dự trên Redis, không cần Formspree.
# 1. Đăng ký miễn phí tại https://formspree.io
# 2. Tạo form mới → lấy Form ID (ví dụ: xyzabc từ URL https://formspree.io/f/xyzabc)
NEXT_PUBLIC_FORMSPREE_ID=

# URL trang web - dùng cho ảnh xem trước khi chia sẻ link (Zalo, Facebook)
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Upstash Redis. Bản deploy của Tơ Hồng bắt buộc hai biến này.
# Thiệp gốc dùng Redis cho sổ lưu bút, xác nhận tham dự và khách mời.
# Vercel → Storage → Upstash Redis → Connect: Vercel tự thêm KV_REST_API_*.
# Chạy trên máy: copy 2 giá trị đó vào .env.local. Chưa có Redis thì dữ liệu nằm trong data/.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Dùng chung database với thiệp khác thì đặt tiền tố riêng để không lẫn dữ liệu, ví dụ: trangdat:
REDIS_KEY_PREFIX=

# Mật khẩu trang /quan-ly của thiệp gốc (xác nhận, khách mời, lời chúc)
GUESTBOOK_ADMIN_PASSWORD=

# Nền tảng Tơ Hồng
# Chuỗi ngẫu nhiên ít nhất 16 ký tự, dùng để ký phiên đăng nhập. Bắt buộc khi deploy.
PLATFORM_SECRET=
# Tài khoản quản trị. Tạo một lần ở lần đăng nhập đầu. Khách tự đăng ký ở /dang-ky bằng email hoặc Facebook.
PLATFORM_ADMIN_USERNAME=
PLATFORM_ADMIN_PASSWORD=
# Đăng nhập Facebook. Tạo ứng dụng tại developers.facebook.com, bật Facebook Login,
# rồi thêm đúng đường dẫn chuyển hướng: https://your-domain.vercel.app/api/auth/facebook/callback
# Thiếu một trong hai thì nút Facebook báo chưa bật, đăng ký email vẫn dùng được.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Thiệp của từng tài khoản lưu trên cùng Redis ở trên (KV_REST_API_*).
# Bản deploy không có Redis sẽ từ chối lưu, không ghi ra ổ đĩa tạm.
# Chạy trên máy, chưa có Redis thì ghi vào data/platform.json và data/ledger.json.
# Ảnh và nhạc tải trong xưởng không ghi vào Redis. Dùng bucket tương thích S3
# (Cloudflare R2, AWS S3 hoặc MinIO). Thiếu một biến thì máy dev ghi vào data/media,
# còn bản deploy từ chối tải file. Redis chỉ giữ mã file, chủ và quyền xem.
# Endpoint là gốc tài khoản, không kèm tên bucket. Region của R2 là auto.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

# Tài khoản nhận chuyển khoản. Để trống số tài khoản thì trang đơn báo chưa cấu hình.
PAYMENT_BANK_NAME=
PAYMENT_ACCOUNT_NUMBER=
PAYMENT_ACCOUNT_NAME=
# Cổng thanh toán VNPAY — luồng PAY thường, API 2.1.3, HMAC-SHA512.
# Lấy TMN Code và Secret Key trong cổng merchant. Để trống VNPAY_RETURN_URL thì
# đường về là địa chỉ trình duyệt đang mở cộng /api/vnpay/return.
# IPN khai riêng trên cổng VNPAY: https://your-domain.vercel.app/api/vnpay/ipn
# Production phải đổi VNPAY_PAY_URL. Để trống thì code dùng sandbox.
VNPAY_TMN_CODE=
VNPAY_SECRET_KEY=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=
# true: chỉ nhận IPN từ IP VNPAY. Bỏ trống thì bật khi NODE_ENV=production.
VNPAY_IPN_WHITELIST=
# Email khi khách xác nhận tham dự. Thiếu một trong hai thì chỉ ghi thông báo trong xưởng.
RESEND_API_KEY=
NOTIFY_FROM=
# Kênh hiện trên trang /lien-he. Để trống thì trang chỉ còn ô để lại lời nhắn.
CONTACT_ZALO=
CONTACT_PHONE=
CONTACT_EMAIL=
CONTACT_FACEBOOK=
